{
  "name": "enterprise-playwright",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable enterprise Playwright automation framework",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "type-check": "pnpm -r --if-present run type-check",
    "test:unit": "pnpm --filter @enterprise-playwright/core test",
    "test:demo": "pnpm --filter @enterprise-playwright/automation-demo-app test",
    "test:demo:smoke": "pnpm --filter @enterprise-playwright/automation-demo-app test:smoke",
    "validate:tags": "pnpm --filter @enterprise-playwright/automation-demo-app validate:tags",
    "allure:clean": "pnpm --filter @enterprise-playwright/automation-demo-app allure:clean",
    "allure:generate": "pnpm --filter @enterprise-playwright/automation-demo-app allure:generate",
    "allure:open": "pnpm --filter @enterprise-playwright/automation-demo-app allure:open",
    "web:demo": "pnpm --filter @enterprise-playwright/automation-demo-app web:dev",
    "build": "pnpm -r --if-present run build",
    "demo:web:dev": "pnpm --filter @enterprise-playwright/automation-demo-app web:dev",
    "demo:web:build": "pnpm --filter @enterprise-playwright/automation-demo-app web:build",
    "demo:test": "pnpm --filter @enterprise-playwright/automation-demo-app test",
    "demo:test:smoke": "pnpm --filter @enterprise-playwright/automation-demo-app test:smoke",
    "demo:allure:generate": "pnpm --filter @enterprise-playwright/automation-demo-app allure:generate",
    "demo:allure:open": "pnpm --filter @enterprise-playwright/automation-demo-app allure:open",
    "support-desk:web:dev": "pnpm --filter @enterprise-playwright/support-desk-demo web:dev",
    "support-desk:web:build": "pnpm --filter @enterprise-playwright/support-desk-demo web:build",
    "support-desk:test": "pnpm --filter @enterprise-playwright/support-desk-demo test",
    "support-desk:test:smoke": "pnpm --filter @enterprise-playwright/support-desk-demo test:smoke",
    "support-desk:allure:generate": "pnpm --filter @enterprise-playwright/support-desk-demo allure:generate",
    "support-desk:allure:open": "pnpm --filter @enterprise-playwright/support-desk-demo allure:open"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}
