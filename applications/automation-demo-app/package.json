{
  "name": "@enterprise-playwright/automation-demo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts --port 3000 --host 127.0.0.1",
    "test": "node ./node_modules/@playwright/test/cli.js test",
    "test:smoke": "node ./node_modules/@playwright/test/cli.js test -g @smoke",
    "test:list": "node ./node_modules/@playwright/test/cli.js test --list",
    "validate:tags": "tsx scripts/validate-tags.ts",
    "allure:clean": "node scripts/allure-clean.mjs",
    "allure:generate": "node scripts/allure-generate.mjs",
    "allure:open": "npx --yes allure-commandline@2.32.0 open allure-report"
  },
  "dependencies": {
    "@enterprise-playwright/core": "workspace:*",
    "@enterprise-playwright/shared-types": "workspace:*",
    "dotenv": "16.4.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "allure-commandline": "2.32.0",
    "allure-js-commons": "3.0.9",
    "allure-playwright": "3.0.9",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
